{% extends 'base.html.twig' %}

{% block title %}Modifier – {{ document.titre }} – ProConnect{% endblock %}

{% block body %}

    <a href="{{ path('app_document_show', {'id': document.id}) }}" class="back-link">← Retour au document</a>

    <div class="proconnect-page-header">
        <div>
            <h1>✏️ Modifier le document</h1>
            <p>{{ document.titre }}</p>
        </div>
    </div>

    <div class="proconnect-card p-4 mb-4">
        {{ include('document/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    </div>

    {% if is_granted('ROLE_ADMIN') %}
    <div class="danger-zone">
        <h6>⚠️ Zone dangereuse</h6>
        <p>La suppression de ce document est irréversible.</p>
        {{ include('document/_delete_form.html.twig') }}
    </div>
    {% endif %}

{% endblock %}
