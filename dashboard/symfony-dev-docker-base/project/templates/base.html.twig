<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{% block title %}ProConnect - Dashboard{% endblock %}</title>
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text></svg>">

    {% block stylesheets %}
    {# Bootstrap pour la mise en page rapide #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    {% endblock %}

    {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% endblock %}

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F5ECD9;
            margin: 0;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* SIDEBAR */
        .sidebar {
            width: 280px;
            background-color: #6B4226;
            color: white;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
        }

        .sidebar-header {
            background-color: #3D2B1A;
            padding: 25px;
            border-bottom: 1px solid #A0722A;
        }

        .sidebar-logo {
            font-weight: 800;
            font-size: 20px;
            color: #E8D5B7;
            margin: 0;
        }

        .nav-section {
            padding: 20px 0;
        }

        .section-title {
            padding: 0 25px;
            font-size: 11px;
            text-transform: uppercase;
            color: #C49A6C;
            letter-spacing: 1px;
            margin-bottom: 10px;
            font-weight: 800;
        }

        .nav-link-custom {
            display: flex;
            align-items: center;
            padding: 12px 25px;
            color: #E8D5B7;
            text-decoration: none;
            transition: 0.2s;
            font-size: 14px;
        }

        .nav-link-custom:hover {
            background-color: #9C6B3C;
            color: white;
        }

        .nav-link-custom.active {
            background-color: #3D2B1A;
            border-left: 5px solid #A0722A;
            color: white;
            font-weight: 600;
        }

        .main-wrapper {
            flex-grow: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            background-color: #F5ECD9;
        }

        .top {
            display: flex;
            justify-content: flex-end;
        }

        .content-area {
            padding: 40px;
        }
    </style>
</head>

<body>
    <nav class="sidebar">
        <div class="sidebar-header">
            <div class="d-flex align-items-center mb-1">
                <img src="{{ asset('images/logo.svg') }}" alt="Logo" style="width: 30px; margin-right: 10px;">
                <p class="sidebar-logo mb-0" style="letter-spacing: 1px;">PROCONNECT</p>
            </div>
            <small style="color: #A0722A; font-weight: 600; font-size: 10px; text-transform: uppercase;">Dashboard
                Métier</small>
        </div>

        <div class="nav-section">
            <p class="section-title">Navigation</p>

            {# Accueil #}
            <a href="{{ path('app_home') }}"
                class="nav-link-custom {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">
                Accueil
            </a>

            {# Demandes (On utilise 'starts with' pour que ça reste actif même lors de l'édition ou la vue d'une
            demande) #}
            <a href="{{ path('app_demande_client_index') }}"
                class="nav-link-custom {{ app.request.attributes.get('_route') starts with 'app_demande_client' ? 'active' : '' }}">
                Demandes
            </a>

            {# Clients / Usagers #}
            <a href="{{ path('app_user_index') }}"
                class="nav-link-custom {{ app.request.attributes.get('_route') starts with 'app_user' ? 'active' : '' }}">
                Clients / Usagers
            </a>

            {# Dossiers Métier #}
            <a href="{{ path('app_projet_index') }}"
                class="nav-link-custom {{ app.request.attributes.get('_route') starts with 'app_projet' ? 'active' : '' }}">
                Dossiers Métier
            </a>
        </div>

        <div class="nav-section">
            <p class="section-title">Outils</p>

            <a href="{{ path('app_document_index') }}"
                class="nav-link-custom {{ app.request.attributes.get('_route') starts with 'app_document' ? 'active' : '' }}">
                Documents
            </a>

            <a href="{{ path('app_intervention_index') }}"
                class="nav-link-custom {{ app.request.attributes.get('_route') starts with 'app_intervention' ? 'active' : '' }}">
                Rapports
            </a>

            {# Pour les pages qui n'ont pas encore de route définie, on laisse vide ou on ajoute les noms si tu les
            crées #}
            <a href="#" class="nav-link-custom">Messages</a>
            <a href="#" class="nav-link-custom">Paramètres</a>
        </div>
    </nav>

    <div class="main-wrapper">
        <div class="top">
            <span style="font-size: 12px; color: #7A7875; margin: 0 40px 0 0; padding: 10px 0;">Connecté en tant que :
                <strong>Professionnel</strong></span>
        </div>

        <div class="content-area">
            {% block body %}{% endblock %}
        </div>
    </div>
</body>

</html>