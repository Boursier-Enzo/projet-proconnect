{% extends 'base.html.twig' %}

{% block title %}Projets – ProConnect{% endblock %}

{% block body %}

    {# ── En-tête ── #}
    <div class="proconnect-page-header">
        <div>
            <h1>📁 Projets</h1>
            <p>Gérez l'ensemble des projets de la plateforme.</p>
        </div>
        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ARCHITECTE') %}
        <a href="{{ path('app_projet_new') }}" class="btn btn-proconnect">
            + Nouveau projet
        </a>
        {% endif %}
    </div>

    {# ── Barre de recherche ── #}
    <div class="mb-4">
        <input
            type="text"
            id="search-input"
            class="proconnect-search"
            placeholder="🔍  Rechercher un projet (titre, statut, adresse…)"
            oninput="filterProjets()"
        >
    </div>

    {# ── Tableau ── #}
    <div class="proconnect-card">
        <div class="table-responsive">
            <table class="table table-hover proconnect-table mb-0" id="projets-table">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">Titre</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Statut</th>
                        <th class="py-3">Date début</th>
                        <th class="py-3">Budget</th>
                        <th class="py-3">Adresse chantier</th>
                        <th class="py-3 pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for projet in projets %}
                    <tr class="projet-row">
                        <td class="ps-4 py-3">
                            <div class="fw-bold" style="color: #3D2B1A;">{{ projet.titre }}</div>
                            {% if projet.description %}
                                <div class="text-muted" style="font-size: 12px;">{{ projet.description|slice(0, 60) }}{% if projet.description|length > 60 %}…{% endif %}</div>
                            {% endif %}
                        </td>
                        <td class="py-3 text-muted" style="font-size: 14px;">{{ projet.typeProjet ?? '—' }}</td>
                        <td class="py-3">
                            {% set s = projet.statut|lower|replace({' ': '_'}) %}
                            <span class="statut-badge statut-{{ s in ['en_cours','termine','en_attente','annule'] ? s : 'default' }}">
                                {{ projet.statut }}
                            </span>
                        </td>
                        <td class="py-3 text-muted" style="font-size: 14px;">
                            {{ projet.dateDebut ? projet.dateDebut|date('d/m/Y') : '—' }}
                        </td>
                        <td class="py-3 text-muted" style="font-size: 14px;">
                            {{ projet.budget ? projet.budget|number_format(0, ',', ' ') ~ ' €' : '—' }}
                        </td>
                        <td class="py-3 text-muted" style="font-size: 14px;">{{ projet.adresseChantier ?? '—' }}</td>
                        <td class="pe-4 py-3 text-end">
                            <div class="btn-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <a href="{{ path('app_projet_show', {'id': projet.id}) }}" class="btn btn-sm btn-light">Voir</a>
                                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ARCHITECTE') %}
                                <a href="{{ path('app_projet_edit', {'id': projet.id}) }}" class="btn btn-sm btn-outline-secondary" style="border-radius: 0;">Modifier</a>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr id="empty-row">
                        <td colspan="7" class="text-center py-5 text-muted">Aucun projet trouvé.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function filterProjets() {
            const query = document.getElementById('search-input').value.toLowerCase().trim();
            const rows  = document.querySelectorAll('.projet-row');
            let visible = 0;
            rows.forEach(row => {
                const match = row.textContent.toLowerCase().includes(query);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            const emptyRow = document.getElementById('empty-search-row');
            if (visible === 0 && rows.length > 0) {
                if (!emptyRow) {
                    const tr = document.createElement('tr');
                    tr.id = 'empty-search-row';
                    tr.innerHTML = '<td colspan="7" class="text-center py-5 text-muted">Aucun résultat pour cette recherche.</td>';
                    document.querySelector('#projets-table tbody').appendChild(tr);
                }
            } else if (emptyRow) {
                emptyRow.remove();
            }
        }
    </script>

{% endblock %}
