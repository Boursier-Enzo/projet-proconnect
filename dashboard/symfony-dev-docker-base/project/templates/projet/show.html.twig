{% extends 'base.html.twig' %}

{% block title %}{{ projet.titre }}{% endblock %}

{% block body %}

<a href="{{ path('app_projet_index') }}">← Retour à la liste</a>

<h1>{{ projet.titre }}</h1>

{# Infos du projet #}
<table>
    <tr>
        <th>Statut</th>
        <td>{{ projet.statut }}</td>
    </tr>
    <tr>
        <th>Type</th>
        <td>{{ projet.typeProjet ?? '—' }}</td>
    </tr>
    <tr>
        <th>Date de début</th>
        <td>{{ projet.dateDebut ? projet.dateDebut|date('d/m/Y') : '—' }}</td>
    </tr>
    <tr>
        <th>Date de fin prévue</th>
        <td>{{ projet.dateFinPrevue ? projet.dateFinPrevue|date('d/m/Y') : '—' }}</td>
    </tr>
    <tr>
        <th>Budget</th>
        <td>{{ projet.budget ? projet.budget|number_format(2, ',', ' ') ~ ' €' : '—' }}</td>
    </tr>
    <tr>
        <th>Adresse chantier</th>
        <td>{{ projet.adresseChantier ?? '—' }}</td>
    </tr>
    <tr>
        <th>Architecte</th>
        <td>{{ projet.architecte ? projet.architecte.email : '—' }}</td>
    </tr>
</table>

{% if projet.description %}
    <h2>Description</h2>
    <p>{{ projet.description }}</p>
{% endif %}

{# Documents rattachés #}
<h2>Documents ({{ projet.documents|length }})</h2>

{% if projet.documents is empty %}
    <p>Aucun document rattaché à ce projet.</p>
{% else %}
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Type</th>
                <th>Fichier</th>
            </tr>
        </thead>
        <tbody>
            {% for document in projet.documents %}
                <tr>
                    <td>{{ document.titre }}</td>
                    <td>{{ document.typeDocument ?? '—' }}</td>
                    <td>
                        {% if document.fichierPath %}
                            <a href="{{ asset(document.fichierPath) }}" target="_blank">
                                Voir le fichier
                            </a>
                        {% else %}
                            —
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endif %}

{# Actions #}
<a href="{{ path('app_projet_edit', { id: projet.id }) }}">Modifier</a>

{{ include('projet/_delete_form.html.twig') }}

{% endblock %}
