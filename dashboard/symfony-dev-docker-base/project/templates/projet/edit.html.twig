{% extends 'base.html.twig' %}

{% block title %}Modifier – {{ projet.titre }} – ProConnect{% endblock %}

{% block body %}

    <a href="{{ path('app_projet_show', {'id': projet.id}) }}" class="back-link">← Retour au projet</a>

    <div class="proconnect-page-header">
        <div>
            <h1>✏️ Modifier le projet</h1>
            <p>{{ projet.titre }}</p>
        </div>
    </div>

    <div class="proconnect-card p-4 mb-4">
        {{ include('projet/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    </div>

    {# ── Danger zone (admin uniquement) ── #}
    {% if is_granted('ROLE_ADMIN') %}
    <div class="danger-zone">
        <h6>⚠️ Zone dangereuse</h6>
        <p>La suppression de ce projet est irréversible.</p>
        {{ include('projet/_delete_form.html.twig') }}
    </div>
    {% endif %}

{% endblock %}
