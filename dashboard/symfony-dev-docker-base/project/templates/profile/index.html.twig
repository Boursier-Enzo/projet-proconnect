{% extends 'base.html.twig' %}

{% block title %}Paramètres – ProConnect{% endblock %}

{% block body %}

    {# ── Flash messages ── #}
    {% for message in app.flashes('success') %}
        <div class="alert border-0 mb-4 shadow-sm" style="border-radius: 10px; background: #d1e7dd; color: #0a3622;">
            ✅ {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert border-0 mb-4 shadow-sm" style="border-radius: 10px; background: #f8d7da; color: #58151c;">
            ❌ {{ message }}
        </div>
    {% endfor %}

    {# ── En-tête ── #}
    <div class="proconnect-page-header mb-4">
        <div>
            <h1>⚙️ Paramètres</h1>
            <p>Gérez votre profil et vos préférences.</p>
        </div>
    </div>

    <div class="row g-4">

        {# ── Colonne gauche : carte profil ── #}
        <div class="col-lg-3">
            <div class="proconnect-card p-4 text-center mb-3">

                {# Avatar initiales #}
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
                    style="width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, #A0722A, #3D2B1A); color: #fff; font-size: 26px; font-weight: 800;">
                    {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                </div>

                <div class="fw-bold" style="color: #3D2B1A; font-size: 16px;">
                    {{ app.user.prenom }} {{ app.user.nom }}
                </div>
                <div class="text-muted" style="font-size: 13px; margin-bottom: 8px;">
                    {{ app.user.email }}
                </div>

                {# Badge rôle #}
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="statut-badge" style="background: #E8D5B7; color: #3D2B1A;">🔧 Administrateur</span>
                {% elseif is_granted('ROLE_ARCHITECTE') %}
                    <span class="statut-badge" style="background: #E8D5B7; color: #3D2B1A;">🏛 Architecte</span>
                {% endif %}

                {# Badge vérifié #}
                <div class="mt-2">
                    {% if app.user.isVerified %}
                        <span class="statut-badge statut-termine">✓ Compte vérifié</span>
                    {% else %}
                        <span class="statut-badge statut-annule">✗ Non vérifié</span>
                    {% endif %}
                </div>

                <div class="mt-3 pt-3 border-top" style="font-size: 12px; color: #9e9890;">
                    Membre depuis {{ app.user.createdAt ? app.user.createdAt|date('d/m/Y') : '—' }}
                </div>
            </div>

            {# Stats rapides (architectes) #}
            {% if is_granted('ROLE_ARCHITECTE') %}
            <div class="proconnect-card p-3 mb-3">
                <div class="info-label mb-2">Activité</div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span style="font-size: 13px; color: #5a5550;">Projets</span>
                    <span class="fw-bold" style="color: #3D2B1A;">{{ app.user.projets|length }}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                    <span style="font-size: 13px; color: #5a5550;">Demandes</span>
                    <span class="fw-bold" style="color: #3D2B1A;">{{ app.user.demandeClients|length }}</span>
                </div>
                <div class="d-flex justify-content-between align-items-center py-2">
                    <span style="font-size: 13px; color: #5a5550;">Interventions</span>
                    <span class="fw-bold" style="color: #3D2B1A;">{{ app.user.interventions|length }}</span>
                </div>
            </div>
            {% endif %}

            {# Bouton déconnexion #}
            <a href="{{ logout_path() }}" class="btn btn-proconnect-danger w-100">
                🚪 Se déconnecter
            </a>
        </div>

        {# ── Colonne droite : formulaire ── #}
        <div class="col-lg-9">
            <div class="proconnect-card p-4">

                <p class="section-title">Informations personnelles</p>

                {% if form.vars.errors|length > 0 %}
                <div class="alert alert-danger border-0 mb-4" style="border-radius: 10px;">
                    {{ form_errors(form) }}
                </div>
                {% endif %}

                {{ form_start(form) }}

                <div class="row g-4">

                    <div class="col-md-6">
                        <label class="proconnect-label">Nom</label>
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>

                    <div class="col-md-6">
                        <label class="proconnect-label">Prénom</label>
                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.prenom) }}
                    </div>

                    <div class="col-md-8">
                        <label class="proconnect-label">Email</label>
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="col-md-4">
                        <label class="proconnect-label">Téléphone</label>
                        {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '06 00 00 00 00'}}) }}
                        {{ form_errors(form.telephone) }}
                    </div>

                    <div class="col-md-6">
                        <label class="proconnect-label">Numéro d'ordre</label>
                        {{ form_widget(form.numeroOrdre, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.numeroOrdre) }}
                    </div>

                    <div class="col-md-6">
                        <label class="proconnect-label">Spécialités</label>
                        {{ form_widget(form.specialites, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Urbanisme, Rénovation…'}}) }}
                        {{ form_errors(form.specialites) }}
                    </div>

                    <div class="col-12">
                        <label class="proconnect-label">Horaires</label>
                        {{ form_widget(form.horaires, {'attr': {'class': 'form-control', 'rows': '2', 'placeholder': 'Ex: Lun-Ven 9h-18h'}}) }}
                        {{ form_errors(form.horaires) }}
                    </div>

                    <div class="col-12">
                        <label class="proconnect-label">Description / Bio</label>
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Présentez-vous…'}}) }}
                        {{ form_errors(form.description) }}
                    </div>

                </div>

                <div class="mt-4 pt-4 border-top d-flex justify-content-end">
                    <button type="submit" class="btn btn-proconnect px-5">
                        💾 Enregistrer les modifications
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>

{% endblock %}
