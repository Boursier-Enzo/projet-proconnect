{% extends 'base.html.twig' %}

{% block title %}Registre des Demandes - ProConnect{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="color: #3D2B1A; font-weight: 800; font-size: 24px; margin: 0;">Registre des Demandes</h1>
            <p class="text-muted small">Consultez et validez les sollicitations clients.</p>
        </div>
        <a href="{{ path('app_demande_client_new') }}" class="btn btn-proconnect">
            + Nouvelle demande
        </a>
    </div>

    {# ── Cartes stats ── #}
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <a href="{{ path('app_demande_client_index', {'statut': 'accepte'}) }}"
               style="text-decoration: none; display: block; padding: 20px; border-radius: 12px;
                      background: {{ filtre_actif == 'accepte' ? '#3D2B1A' : '#FFFFFF' }};
                      border: 1px solid {{ filtre_actif == 'accepte' ? '#3D2B1A' : '#E0DDD8' }};
                      box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: 0.3s;">
                <div style="font-size: 24px; font-weight: 800; color: {{ filtre_actif == 'accepte' ? '#E8D5B7' : '#198754' }};">{{ nb_acceptes }}</div>
                <div style="color: {{ filtre_actif == 'accepte' ? '#fff' : '#7A7875' }}; font-size: 14px; font-weight: 600;">Demandes acceptées</div>
            </a>
        </div>

        <div class="col-md-5">
            <a href="{{ path('app_demande_client_index', {'statut': 'non_accepte'}) }}"
               style="text-decoration: none; display: block; padding: 20px; border-radius: 12px;
                      background: {{ filtre_actif == 'non_accepte' ? '#3D2B1A' : '#FFFFFF' }};
                      border: 1px solid {{ filtre_actif == 'non_accepte' ? '#3D2B1A' : '#E0DDD8' }};
                      box-shadow: 0 4px 6px rgba(0,0,0,0.02); transition: 0.3s;">
                <div style="font-size: 24px; font-weight: 800; color: {{ filtre_actif == 'non_accepte' ? '#E8D5B7' : '#dc3545' }};">{{ nb_non_acceptes }}</div>
                <div style="color: {{ filtre_actif == 'non_accepte' ? '#fff' : '#7A7875' }}; font-size: 14px; font-weight: 600;">Demandes non acceptées</div>
            </a>
        </div>

        {% if filtre_actif %}
        <div class="col-md-2 d-flex">
            <a href="{{ path('app_demande_client_index') }}" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center" style="border-radius: 12px; font-size: 13px;">
                ✕ Reset
            </a>
        </div>
        {% endif %}
    </div>

    {# ── Tableau ── #}
    <div class="proconnect-card">
        <div class="table-responsive">
            <table class="table table-hover proconnect-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">ID / Objet</th>
                        <th class="py-3">Client</th>
                        <th class="py-3">Type</th>
                        <th class="py-3">Créneau</th>
                        <th class="py-3">Statut</th>
                        <th class="py-3 pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for demande_client in demande_clients %}
                    <tr>
                        <td class="ps-4 py-3">
                            <span class="text-muted small">#{{ demande_client.id }}</span>
                            <div class="fw-bold" style="color: #3D2B1A;">{{ demande_client.objet }}</div>
                        </td>
                        <td class="py-3">
                            {% if demande_client.client %}
                                <div class="fw-bold" style="color: #3D2B1A; font-size: 13px;">
                                    {{ demande_client.client.prenom }} {{ demande_client.client.nom }}
                                </div>
                                <div class="text-muted" style="font-size: 12px;">{{ demande_client.client.email }}</div>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="py-3 text-muted" style="font-size: 14px;">{{ demande_client.typePrestation ?? '—' }}</td>
                        <td class="py-3 text-muted" style="font-size: 13px;">
                            {{ demande_client.creneauSouhaite ? demande_client.creneauSouhaite|date('d/m/Y H:i') : '—' }}
                        </td>
                        <td class="py-3">
                            <span class="statut-badge {{ demande_client.statut == 'accepte' ? 'statut-termine' : 'statut-annule' }}">
                                {{ demande_client.statut == 'accepte' ? '✓ Acceptée' : '✗ Non acceptée' }}
                            </span>
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <div class="btn-group shadow-sm" style="border-radius: 8px; overflow: hidden;">
                                <a href="{{ path('app_demande_client_show', {'id': demande_client.id}) }}" class="btn btn-sm btn-light">Voir</a>

                                {% if demande_client.statut != 'accepte' %}
                                <form method="post" action="{{ path('app_demande_client_accepter', {'id': demande_client.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('accepter' ~ demande_client.id) }}">
                                    <button type="submit" class="btn btn-sm btn-success" style="border-radius: 0;">Accepter</button>
                                </form>
                                {% endif %}

                                <form method="post" action="{{ path('app_demande_client_delete', {'id': demande_client.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer définitivement ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ demande_client.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" style="border-radius: 0;">Suppr.</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">Aucune demande trouvée.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
