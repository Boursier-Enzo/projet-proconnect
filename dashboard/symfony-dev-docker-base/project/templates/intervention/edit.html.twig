{% extends 'base.html.twig' %}

{% block title %}Modifier – {{ intervention.titre }} – ProConnect{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.css">
    <style>
        .EasyMDEContainer .CodeMirror { border-radius: 0 0 8px 8px; border-color: #E0DDD8; font-size: 14px; min-height: 280px; color: #3D2B1A; }
        .EasyMDEContainer .editor-toolbar { border-color: #E0DDD8; border-radius: 8px 8px 0 0; background: #faf8f5; }
        .EasyMDEContainer .editor-toolbar button:hover, .EasyMDEContainer .editor-toolbar button.active { background: #E8D5B7; border-color: #A0722A; }
        .editor-preview { background: #faf8f5; color: #3D2B1A; }
    </style>
{% endblock %}

{% block body %}

    <a href="{{ path('app_intervention_show', {'id': intervention.id}) }}" class="back-link">← Retour au rapport</a>

    <div class="proconnect-page-header">
        <div>
            <h1>✏️ Modifier le rapport</h1>
            <p>{{ intervention.titre }}</p>
        </div>
    </div>

    <div class="proconnect-card p-4 mb-4">
        {{ include('intervention/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    </div>

    {% if is_granted('ROLE_ADMIN') %}
    <div class="danger-zone">
        <h6>⚠️ Zone dangereuse</h6>
        <p>La suppression de ce rapport est irréversible.</p>
        {{ include('intervention/_delete_form.html.twig') }}
    </div>
    {% endif %}

{% endblock %}
