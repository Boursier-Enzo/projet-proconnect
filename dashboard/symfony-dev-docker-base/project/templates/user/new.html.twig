{% extends 'base.html.twig' %}

{% block title %}Nouvel Utilisateur - ProConnect{% endblock %}

{% block body %}
    <div class="new-page">
        <div class="mb-4">
            <a href="{{ path('app_user_index') }}" class="back-link">← Retour à la liste</a>
        </div>

        <div class="form-card">
            <div class="card-head">
                <h1 class="card-title h4 mb-1">Créer un nouvel utilisateur</h1>
                <p class="card-subtitle">Remplissez les informations pour enregistrer un nouvel utilisateur.</p>
            </div>
            <div class="card-body p-4 bg-white">
                {{ include('user/_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
