{{ form_start(form) }}
    <div class="alert alert-danger shadow-sm border-0" style="display: {{ form.vars.errors|length > 0 ? 'block' : 'none' }};">
        {{ form_errors(form) }}
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Nom</label>
            {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Dupont'}}) }}
            {{ form_errors(form.nom) }}
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Prénom</label>
            {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Jean'}}) }}
            {{ form_errors(form.prenom) }}
        </div>

        <div class="col-md-8">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Email</label>
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'jean.dupont@email.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        <div class="col-md-4">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Téléphone</label>
            {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '06 00 00 00 00'}}) }}
            {{ form_errors(form.telephone) }}
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Numéro d'ordre</label>
            {{ form_widget(form.numeroOrdre, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.numeroOrdre) }}
        </div>

        <div class="col-md-6">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Spécialités</label>
            {{ form_widget(form.specialites, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Urbanisme, Rénovation…'}}) }}
            {{ form_errors(form.specialites) }}
        </div>

        <div class="col-12">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Horaires</label>
            {{ form_widget(form.horaires, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Lun-Ven 9h-18h'}}) }}
            {{ form_errors(form.horaires) }}
        </div>

        <div class="col-12">
            <label class="form-label fw-bold small text-uppercase" style="color: #6B4226; letter-spacing: 0.5px;">Description</label>
            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': '4', 'placeholder': 'Décrivez le profil…'}}) }}
            {{ form_errors(form.description) }}
        </div>
    </div>

    {# Actions #}
    <div class="mt-5 pt-4 border-top d-flex justify-content-end gap-2">
        <a href="{{ path('app_user_index') }}" class="btn btn-light px-4" style="font-weight: 600; color: #7A7875;">
            Annuler
        </a>
        <button class="btn px-5 text-white" style="background-color: #A0722A; font-weight: 700; border-radius: 8px; box-shadow: 0 4px 12px rgba(160, 114, 42, 0.2);">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
{{ form_end(form) }}
