{% extends 'base.html.twig' %}

{% block title %}Modifier {{ user.nom }} {{ user.prenom }} - ProConnect{% endblock %}

{% block body %}
    <div class="new-page">
        <div class="mb-4">
            <a href="{{ path('app_user_index') }}" class="back-link">← Retour à la liste</a>
        </div>

        <div class="form-card">
            <div class="card-head">
                <h1 class="card-title h4 mb-1">Modifier l'utilisateur</h1>
                <p class="card-subtitle">{{ user.nom }} {{ user.prenom }} — {{ user.email }}</p>
            </div>
            <div class="card-body p-4 bg-white">
                {{ include('user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>

        <div class="mt-3 d-flex justify-content-end">
            {{ include('user/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
