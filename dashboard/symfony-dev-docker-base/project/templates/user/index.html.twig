{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}

{% block body %}

    
    <h1>Client</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th><th>Email</th><th>Roles</th><th>Password</th>
                <th>Nom</th><th>Prenom</th><th>Telephone</th><th>NumeroOrdre</th>
                <th>Description</th><th>Horaires</th><th>Specialites</th>
                <th>CreatedAt</th><th>UpdatedAt</th><th>IsVerified</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            {% if 'ROLE_USER' in user.roles and 'ROLE_ARCHITECTE' not in user.roles and 'ROLE_ADMIN' not in user.roles %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                    <td>{{ user.password }}</td>
                    <td>{{ user.nom }}</td>
                    <td>{{ user.prenom }}</td>
                    <td>{{ user.telephone }}</td>
                    <td>{{ user.numeroOrdre }}</td>
                    <td>{{ user.description }}</td>
                    <td>{{ user.horaires }}</td>
                    <td>{{ user.specialites }}</td>
                    <td>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ user.updatedAt ? user.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td>{{ user.isVerified ? 'Yes' : 'No' }}</td>
                    <td>
                        <a href="{{ path('app_user_show', {'id': user.id}) }}">show</a>
                        <a href="{{ path('app_user_edit', {'id': user.id}) }}">edit</a>
                    </td>
                </tr>
            {% endif %}
        {% else %}
            <tr><td colspan="15">no records found</td></tr>
        {% endfor %}
        </tbody>
    </table>

    
